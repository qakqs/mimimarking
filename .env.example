# Big Market Docker 环境变量
# 复制此文件为 .env 后按需修改，不要提交 .env 到仓库

# MySQL root 密码
MYSQL_ROOT_PASSWORD=root123

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123

# Nacos namespace（与 application-dev.yml 中保持一致）
NACOS_NAMESPACE=31d0c17d-9bc6-417e-adce-394cf99e2da8

# JWT 密钥（生产环境务必更换为强随机字符串）
JWT_SECRET=big-market-jwt-secret-key-2024
